<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ArtistDirect - Platformă gratuită pentru conectarea directă cu artiști muzicali. Fără comisioane, fără intermediari.">
    <title>ArtistDirect - Page Under Construction</title>
    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/style.css">
    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .construction-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: var(--color-cream);
            padding: 2rem;
            text-align: center;
        }

        .construction-logo {
            max-width: 300px;
            width: 100%;
            height: auto;
            margin-bottom: 2rem;
            animation: fadeIn 1s ease-out;
        }

        .construction-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 500;
            color: var(--color-text);
            margin-bottom: 1rem;
            animation: fadeIn 1s ease-out 0.3s both;
        }

        .construction-message {
            font-size: clamp(1rem, 2vw, 1.25rem);
            color: var(--color-text-light);
            max-width: 600px;
            line-height: 1.8;
            animation: fadeIn 1s ease-out 0.6s both;
        }
    </style>
</head>
<body>
    <div class="page-container">
        <div class="construction-container">
            <img src="/static/landing-logo.png" alt="ArtistDirect" class="construction-logo">
            <h1 class="construction-title">ArtistDirect</h1>
            <p class="construction-message">Pagina este în construcție.<br>Revenim în curând!</p>
        </div>
    </div>
    
    <%- include('footer') %>
</body>
</html>
